/outputs/
/deliverables/
/.deck_work/
/.poster_work/
/*.pptx
/*.pdf

# Python, notebook, IDE and OS scratch files.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
*.log
~$*

